# PostgreSQL connection string
DATABASE_URL="postgresql://ueds_user:ueds_password@localhost:5432/ueds_db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Admin login used by the seed script
ADMIN_EMAIL="admin@ueds.org"
ADMIN_PASSWORD="ChangeMe123!"

# SMTP settings used to send Contact Us form submissions to the office email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
MAIL_FROM="UEDS Website <no-reply@ueds.org>"
OFFICE_EMAIL="office@ueds.org"

# Public site URL (used in a couple of absolute links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
